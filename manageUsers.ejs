<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>List Users</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <nav class="navbar bg-body-tertiary mb-4">
        <div class="container-fluid"><span class="navbar-brand mb-0 h1">User Management</span></div>
    </nav>
    <div class="container">
        <div class="row">
            <div class="col-md-4 bg-light p-3">
                <form action="/users" method="post">
                    <div class="form-group m-2">
                        <label for="fname">First Name</label>
                        <input id="fname" type="text" class="form-control" name="fname" maxlength="50" required>
                    </div>
                    <div class="form-group m-2">
                        <label for="lname">Last Name</label>
                        <input id="lname" type="text" class="form-control" name="lname" maxlength="50" required>
                    </div>
                    <div class="form-group m-2">
                        <label for="username">User Name</label>
                        <input id="username" type="text" class="form-control" name="username" maxlength="50" required>
                    </div>
                    <div class="form-group m-2">
                        <label for="passwd">Password</label>
                        <input id="passwd" type="password" class="form-control" name="passwd" required>
                    </div>
                    <button type="submit" class="btn btn-primary m-2">Submit</button>
                </form>
            </div>
            <div class="col-md-8 table-responsive">
                <table class="table table-striped">
                    <thead><tr><th>ID</th><th>First Name</th><th>Last Name</th><th>User Name</th><th>Password</th></tr></thead>
                    <tbody>
                        <% users.forEach(function (user) { %>
                        <tr>
                            <td><%= user.userID %></td>
                            <td><%= user.fname %></td>
                            <td><%= user.lname %></td>
                            <td><%= user.username %></td>
                            <td><%= user.passwd %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
